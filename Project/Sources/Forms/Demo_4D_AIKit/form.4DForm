{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 620,
	"windowMinHeight": 540,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"css": [
		"Demo_4D_AIKit.css"
	],
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onOutsideCall",
		"onDoubleClick",
		"onDrop",
		"onMenuSelect",
		"onPluginArea",
		"onDragOver",
		"onTimer",
		"onAfterKeystroke",
		"onAfterEdit",
		"onBeginDragOver",
		"onBoundVariableChange",
		"onPageChange"
	],
	"windowTitle": "AI PDF Summarizer",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"DropZone": {
					"type": "input",
					"text": "Drag & Drop a PDF file here or click to browse",
					"left": 20,
					"top": 17,
					"width": 392,
					"height": 32,
					"readOnly": true,
					"multiline": "yes",
					"backgroundColor": "#EFF3F8",
					"borderStyle": "none",
					"cornerRadius": 16,
					"events": [
						"onClick",
						"onDrop",
						"onDragOver"
					],
					"method": "ObjectMethods/DropZone.4dm",
					"dataSource": "Form:C1466.pdfPath",
					"dragging": "none",
					"enterable": false,
					"focusable": false,
					"dropping": "custom"
				},
				"UploadButton": {
					"type": "button",
					"left": 420,
					"top": 17,
					"width": 160,
					"height": 32,
					"backgroundColor": "#2563EB",
					"textColor": "#FFFFFF",
					"borderStyle": "rounded",
					"cornerRadius": 12,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/Analyze.4dm"
				},
				"HiddenFilePath": {
					"type": "input",
					"left": 0,
					"top": 0,
					"width": 1,
					"height": 1,
					"visible": false,
					"enabled": false,
					"dataSource": "Form.pdfPath"
				},
				"web area": {
					"type": "webArea",
					"left": 20,
					"top": 69,
					"width": 560,
					"height": 526,
					"webEngine": "embedded",
					"methodsAccessibility": "all",
					"borderStyle": "none",
					"events": [
						"onEndURLLoading"
					],
					"method": "ObjectMethods/web area.4dm",
					"visibility": "hidden"
				},
				"Input": {
					"type": "input",
					"left": 20,
					"top": 601,
					"width": 560,
					"height": 48,
					"dataSource": "Form:C1466.prompt",
					"events": [
						"onAfterEdit"
					],
					"method": "ObjectMethods/Input.4dm"
				},
				"Button": {
					"type": "button",
					"text": "",
					"top": 606,
					"left": 539,
					"width": 40,
					"height": 40,
					"events": [
						"onClick"
					],
					"imageHugsTitle": false,
					"icon": "/RESOURCES/arrow.png",
					"textPlacement": "center",
					"style": "circular",
					"method": "ObjectMethods/Button.4dm"
				}
			}
		}
	],
	"geometryStamp": 253,
	"method": "method.4dm",
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	}
}